#microprograma para uma calculadora estatística capaz de calcular o coeficiente de pearson

FETCH0: mar := pc; rd;
FETCH1: pc := pc + 1; rd;

DECOD0: alu := mbr; if z then goto HALT0;

DECOD1: ir := mbr; if n then goto DECOD9;                       # x---------------
DECOD2: tir := lshift (ir + ir); if n then goto DECOD6;         # 0x--------------
DECOD3: tir := lshift (tir); if n then goto DECOD5;             # 00x-------------
DECOD4: alu := tir; if n then goto STOD0;                       # 000x------------

LODD0: mar := ir; rd;                                           # 0000------------
LODD1: rd;
LODD2: ac := mbr; goto FETCH0;

STOD0: mar := ir; mbr := ac; wr;                                # 0001------------
STOD1: wr; goto FETCH0;

DECOD5: alu := tir; if n then goto VMULT0;                       # 001x------------

ADDD0: mar := ir; rd;                                           # 0010------------
ADDD1: rd;
ADDD2: ac := mbr + ac; goto FETCH0;

#ac: tamanho do vetor X e Y
#a : posição atual de endereço no vetor X
#b : posição atual de endereço no vetor Y -- Já deve ser inicializado anteriormente.
#c : valor dentro do endereço atual do vetor X
#d : valor dentro do endereço atual do vetor Y
#e : tamanho do vetor X e Y negativado
#f : copia do registrador c ( usada na multiplicação) 
# Microinstrução multiplica elemento x_i por y_i e guarda no elemento x_i
VMULT0: mar := ir; rd;                              # 0011------------
VMULT1: e := inv(ac); rd;
VMULT2: e := e + 1;  
VMULT3: c := mbr;
VMULT4: mar := b; rd;
VMULT5: a := band(ir,amask);rd;
VMULT6: d := mbr;
VMULT7 : alu := d; if z then goto VMULT33;
VMULT8 : alu := d; if n then goto VMULT16;
VMULT9: d := inv(d);
VMULT10: d := d +1;
VMULT11: f := c;
VMULT12: c := 0;
VMULT13: c := c + f;
VMULT14: d := d +1; if n then goto VMULT13;
VMULT15: goto VMULT22;
VMULT16: f:= c;
VMULT17: c := 0;
VMULT18: c := c+f;
VMULT19: d := d +1; if n then goto  VMULT18;
VMULT20: c := inv(c);
VMULT21: c := c+1;
VMULT22: mar := a; mbr := c; wr;
VMULT23: wr;
VMULT24: b := b +1;
VMULT25: a := a +1;
VMULT26: e := e+1; if n then goto VMULT28;
VMULT27 : goto FETCH0;
VMULT28: mar := a; rd;
VMULT29 : rd;
VMULT30 : c := mbr;
VMULT31 : mar := b; rd;
VMULT32 : rd;goto VMULT6;
VMULT33: c := 0; goto VMULT22;  # Caso em que y_i é = 0

# + + = inv(d) , 
# + - = pula inv(d), negativa o resultado
# - - = pula inv(d), negativa o resultado
# - + = inv(d) 
                                           # 0011------------


DECOD6: tir := lshift (tir); if n then goto DECOD8;             # 01x-------------
DECOD7: alu := tir; if n then goto JZER0;                       # 010x------------

JPOS0: alu := ac; if n then goto FETCH0;                        # 0100------------
JPOS1: pc := band (ir, amask); goto FETCH0;

JZER0: alu := ac; if z then goto JPOS1;                         # 0101------------
JZER1: goto FETCH0;

DECOD8: alu := tir; if n then goto LOCO0;                       # 011x------------

JUMP0: pc := band (ir, amask); goto FETCH0;                     # 0110------------

LOCO0: ac := band (ir, amask); goto FETCH0;                     # 0111------------

DECOD9: tir := lshift (ir + ir); if n then goto DECOD13;        # 1x--------------
DECOD10: tir := lshift (tir); if n then goto DECOD12;           # 10x-------------
DECOD11: alu := tir; if n then goto DIV0;                      # 100x------------
                               
#multiplicação
MULT0: mar := ir; rd;               # 1000------------
MULT1: a := ac;rd;
MULT2: c := mbr; if n then  goto MULT9;
MULT3: c := c + (-1);
MULT4: c := inv (c);
MULT5: c := c+1;
MULT6: a := a+ac;
MULT7: c := c + 1; if n then goto MULT6;
MULT8: goto FETCH0;
MULT9: alu := a; if n then goto MULT15;
MULT10: c := c+1;
MULT11: a := a + ac;
MULT12: c := c +1; if n then goto MULT11;
MULT13: a := inv(a);
MULT14: a := a+1; goto FETCH0;
MULT15: a := inv(a);
MULT16: a := a +1;
MULT17: ac := a; goto MULT5;

# ac = ac/m[x]
DIV0:mar:=ir;rd;  # 1001------------
DIV1:c := 0;rd;
DIV2:alu := ac; if n then goto DIV5; 
DIV3:b := mbr; if n then goto DIV9; 
DIV4: goto DIV11 ; 
DIV5: ac := inv(ac); 
DIV6: ac := ac +1; 
DIV7: b:=mbr; if n then goto DIV15;
DIV8: goto DIV17 ; 
DIV9: ac := ac +b; if n then goto DIV21; 
DIV10: c := c +(-1); goto DIV9;
DIV11: b :=inv(b); 
DIV12: b := b+1; 
DIV13: ac := ac +b; if n then goto DIV21; 
DIV14: c := c +1; goto DIV13;
DIV15: ac := ac +b; if n then goto DIV21; 
DIV16: c := c +1; goto DIV15;
DIV17: b := inv(b); 
DIV18: b := b+1; 
DIV19: ac := ac +b; if n then goto DIV21;
DIV20: c := c+ (-1); goto DIV19;
DIV21: ac := c; goto FETCH0;                 
                                    

DECOD12: alu := tir; if n then goto VSUB0;                      # 101x------------

# ac = tamanho do vetor positivado/ resultado final
# a : posição de endereço atual do vetor
# b : valor de endereço atual
# c : tamanho do vetor negativado

SUM0: mar:= ir; rd;   # 1010------------
SUM1: c := inv(ac);rd;
SUM2: c := c +1;
SUM3: ac := 0;
SUM4: a := band(ir,amask);
SUM5: b := mbr;
SUM6: ac := ac +b;
SUM7: a := a +1;
SUM8: c := c +1; if n then goto SUM10;
SUM9: goto FETCH0;
SUM10: mar:= a;rd;
SUM11: rd; goto SUM5;

###subtração de valores de um vetor por um imediato###
#ac : tamanho do vetor ( positivo)
#c : tamanho do vetor (negativado)
#b : posição atual de endereço no vetor 
#a : valor dentro do endereço atual
#f : imediato 
VSUB0: mar := ir; rd;             # 1010------------
VSUB1: c := inv(ac);rd;
VSUB2: c := c +1;
VSUB3: f := inv(f);
VSUB4: f := f +1;
VSUB5: b := ir;
VSUB6: a := mbr;
VSUB7: a := a + f;
VSUB8: mar := b; mbr := a; wr;
VSUB9: b := b+1;wr;
VSUB10: mar := b; rd;
VSUB11: c:= c+1;rd;
VSUB12: alu:=c;if n then goto VSUB6;
VSUB13:goto FETCH0;

DECOD13: tir := lshift (tir); if n then goto DECOD15;           # 11x-------------
DECOD14: alu := tir; if n then goto JNZE0;                      # 110x------------

JNEG0: alu := ac; if n then goto JPOS1;                         # 1100------------
JNEG1: goto FETCH0;

JNZE0: alu := ac; if z then goto FETCH0;                        # 1101------------
JNZE1: pc := band (ir, amask); then goto FETCH0;

DECOD15: tir := lshift (tir); if n then goto DECOD16;           # 111x------------

###exponenciação ao quadrado de valores de um vetor###
#ac = tamanho do vetor (positivo)
#a = tamanho do vetor (negativo) / contador do laço externo (percorrer vetor)
#b =  endereço da posição atual no vetor
#c = valor presente no endereço da posição atual no vetor
#d = contador do laço interno (multiplicação)
#e = preserva o valor presente no endereço da posição atual
VQUAD0: mar := ir; rd;                   # 1110------------
VQUAD1: a := inv(ac); rd;
VQUAD2: a := a +1;
VQUAD3: b:=ir;
VQUAD4: c:=mbr;
VQUAD5: alu:= c + (-1); if z then goto  VQUAD13;
VQUAD6: alu:= c + 1; if z then goto VQUAD23;
VQUAD7: e := c; if n then goto VQUAD20;
VQUAD8: d := inv(c) ;
VQUAD9: d := d+1;
VQUAD10: d:= d+1;
VQUAD11: c := e + c;
VQUAD12: d := d+1; if n then goto VQUAD11;
VQUAD13: mar := b; mbr := c;wr;
VQUAD14: b:=b+1;wr;
VQUAD15: mar := b; rd;
VQUAD16: rd;
VQUAD17: a := a+1;
VQUAD18: alu:= a; if n then goto VQUAD4;
VQUAD19: goto FETCH0;
VQUAD20: d:= c+1;
VQUAD21: c := e+ c;
VQUAD22: d:= d+1; if n then goto VQUAD21;
VQUAD23: c := inv(c);
VQUAD24: c := c+1;
VQUAD25: goto VQUAD13;

DECOD16: tir := lshift (tir); if n then goto DECOD20;           # 1111x-----------
DECOD17: tir := lshift (tir); if n then goto DECOD19;           # 11110x----------
DECOD18: alu := tir; if n then goto POPI0;                      # 111100x---------

PSHI0: mar := ac; rd;                                           # 1111000---------
PSHI1: sp := sp + (-1); rd;
PSHI2: mar := sp; wr; goto STOD1;

POPI0: mar := sp; sp := sp + 1; rd;                             # 1111001---------
POPI1: rd;
POPI2: mar := ac; wr; goto STOD1;

DECOD19: alu := tir; if n then goto POP0;                       # 111101x---------

# ac : tamanho do vetor positivado
# c : tamanho do vetor negativado
# a : posição de endereço atual do vetor ( ja anexada)
# e, f : registradores para multiplicar por 100
VCEM0: c := inv(ac);        # 1111010---------
VCEM1: c := c +1;
VCEM2: mar := a;rd;
VCEM3: rd;
VCEM4: e := mbr;
VCEM5: e := lshift(e+e); # e = x4
VCEM6: f := e;
VCEM7: e := lshift(e+e); # e = x16
VCEM8: e := lshift(e); # e = x32
VCEM9: f := e+f; # f = x36
VCEM10: e := lshift(e); # e = x64
VCEM11: e := e +f; # e = x100
VCEM12: mar := a;mbr:= e; wr;
VCEM13: wr;
VCEM14: a := a +1;
VCEM15: c := c+1; if n then goto VCEM2;
VCEM15: goto FETCH0;
                                                              # 1111010---------


POP0: mar := sp; sp := sp + 1; rd;                              # 1111011---------
POP1: rd;
POP2: ac := mbr; goto FETCH0;

DECOD20: tir := lshift (tir); if n then goto DECOD22;           # 11111x----------
DECOD21: alu := tir; if n then goto SWAP0;                      # 111110x---------

RETN0: mar := sp; sp := sp + 1; rd;                             # 1111100---------
RETN1: rd;
RETN2: pc := mbr; goto FETCH0;

SWAP0: f := sp;                                                 # 1111101---------
SWAP1: sp := ac;
SWAP2: ac := f; goto FETCH0;

DECOD22: tir := lshift (tir); if n then goto DECOD23;           # 111111x---------
   

INSP0: f := band (ir, smask);                                   # 1111110---------
INSP1: sp := sp + f; goto FETCH0;
   


DECOD23: tir := lshift (tir); if n then goto DECOD24;           # 1111111x--------

# a = endereço do vetor x ( já instanciado anteriormente)
# b = endereço do vetor aux ( já instanciado anteriormente)
# ac = tamanho do vetor positivado
# c = tamanho do vetor negativado
VCOPY0: alu := ac; if z then goto FETCH0;            # 11111110--------
VCOPY1: c := inv(ac);
VCOPY2: c := c +1;
VCOPY3: mar := a; rd;
VCOPY4: rd;
VCOPY5: mar := b; wr;
VCOPY6: wr;
VCOPY7: a := a +1;
VCOPY8: b := b +1;
VCOPY9: c := c +1; if n then goto VCOPY3;
VCOPY10: goto FETCH0;
                           


DECOD24: tir := lshift (tir); if n then goto DECOD28;           # 11111111x-------
DECOD25: tir := lshift (tir); if n then goto DECOD27;           # 111111110x------
DECOD26: tir := lshift (tir); if n then goto SWAPB0;            # 1111111100x-----

SWAPA0: f := a;                                                 # 11111111000-----
SWAPA1: a := ac; goto SWAP2;

SWAPB0: f := b;                                                 # 11111111001-----
SWAPB1: b := ac; goto SWAP2;

DECOD27: alu := tir; if n then goto SWAPD0;                     # 1111111101x-----

SWAPC0: f := c;                                                 # 11111111010-----
SWAPC1: c := ac; goto SWAP2;

SWAPD0: f := d;                                                 # 11111111011-----
SWAPD1: d := ac; goto SWAP2;

DECOD28: tir := lshift(tir); if n then goto DECOD29;            # 111111111x------

SWAPE0: f := e;                                                 # 1111111110------
SWAPE1: e := ac; goto SWAP2;

DECOD29: tir := lshift(tir); if n then goto DECOD30;             # 1111111111x-----

ECALL0: syscall; goto FETCH0;                                   # 11111111110-----

DECOD30: alu := tir; if n then goto MOD0;                      # 11111111111x----

#verifica se um valor é negativo
BNEG0: alu := ac; if n then goto BNEG2;                        # 111111111110----                 
BNEG1: b:= 0; goto FETCH0;
BNEG2: b:= 1; goto FETCH0;
                             
#calcula o módulo de um valor
MOD0: d := inv(ac);                                             # 111111111111----
MOD1: d := d +1;
MOD2: alu := d; if n then goto FETCH0;
MOD3: ac := d; goto FETCH0;  
                                      
HALT0: ac := lshift (1 + 1);                                     # 0000000000000000
HALT1: ac := lshift (ac + 1); syscall; goto FETCH0;
